__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# Anchored: setuptools' build/ at the root only, so results/*/build/ -- the
# published vmlinux link logs -- is not swallowed with it.
/build/
/dist/
.venv/
venv/

# kreach work directories: stage outputs and build trees.  A run writes
# s1/ .. s7/ plus build trees under -w, none of which belongs in the repo.
kreach-out/
work/

# Kernel configurations in general are build artefacts ...
*.config
# ... except the reproducers published with the findings.  A finding's whole
# claim is that the configuration is there to check rather than take on
# trust, so every published .config has to survive this rule.  The narrower
# earlier version missed three of the four places they live, leaving 17
# dangling links in a repo cited from upstream patches.
!results/witness/*.config
!results/**/witness/*.config
!results/incidental/*.config

# coverage, printed in CI rather than uploaded anywhere
.coverage
coverage.xml
htmlcov/

# Scratch runners for long jobs, not part of the tool.
.chain.sh
.xeconfirm.sh

# Prepared kernel patches are kept out of the repository by choice.  What was
# sent is permanently and publicly archived on lore.kernel.org, which is the
# canonical record; keeping a second copy here only invites someone to apply a
# series that is already upstream.  The reproducer for every finding, which is
# what the cover letters promise, stays under results/.
/outgoing/
/outgoing-arm64/
