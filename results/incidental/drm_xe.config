# Minimal reproducer for the DRM_XE / CONFIGFS_FS link failure, as a
# KCONFIG_ALLCONFIG fragment:
#
#   make O=<build> KCONFIG_ALLCONFIG=drm_xe.config allnoconfig
#   make O=<build> -j$(nproc) vmlinux
#
# Confirmed on v7.3, ARCH=x86_64: the link fails on eleven xe_configfs_*
# symbols in 245 s.
CONFIG_DRM_XE=y
CONFIG_CONFIGFS_FS=m
CONFIG_DRM=y
CONFIG_PCI=y
CONFIG_MODULES=y
